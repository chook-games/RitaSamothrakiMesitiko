---
import { getCategories, getOfficeSettings, officePhones } from '../lib/supabase'
import type { Category } from '../lib/supabase'
import PhoneIcon from './PhoneIcon.astro'
import { t, localizePath, withBase, pick, type Lang } from '../i18n/utils'

export interface Props {
  lang?: Lang
}

const lang: Lang = Astro.props.lang ?? 'el'

const categories = await getCategories()
const settings = await getOfficeSettings()

const phones = officePhones(settings)
const logoHeight = Number(settings?.logo_height) || 40

const agoraCategories = categories.filter(c => c.type === 'agora')
const enoikiasiCategories = categories.filter(c => c.type === 'enoikiasi')

const catName = (c: Category) => pick(lang, c.name_el, c.name_en)

// Language switcher targets (same page, other language)
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '')
let pathNoBase = Astro.url.pathname.slice(base.length)
if (!pathNoBase.startsWith('/')) pathNoBase = '/' + pathNoBase
const pathNoLang = pathNoBase.replace(/^\/en(\/|$)/, '/')
const elHref = withBase(pathNoLang)
const enHref = withBase(`/en${pathNoLang === '/' ? '' : pathNoLang}`)

const navItems = [
  { href: localizePath('/', lang), label: t(lang, 'nav.home') },
  { href: localizePath('/agora', lang), label: t(lang, 'nav.agora') },
  { href: localizePath('/enoikiasi', lang), label: t(lang, 'nav.enoikiasi') },
  { href: localizePath('/grafeio', lang), label: t(lang, 'nav.grafeio') },
]
---

<header class="bg-white/95 backdrop-blur-md shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href={localizePath('/', lang)} class="flex items-center gap-3 group">
        {settings?.logo_url ? (
          <img id="header-logo" src={settings.logo_url} alt={settings.name} class="w-auto" style={`height:${logoHeight}px`} />
        ) : (
          <div id="header-logo-fallback" class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center text-white font-bold text-lg">
            RS
          </div>
        )}
        <div class="hidden sm:block">
          <h1 id="header-office-name" class="text-lg font-bold text-primary leading-tight">{pick(lang, settings?.name || 'Rita Samothraki', settings?.name_en || settings?.name || 'Rita Samothraki')}</h1>
          <p class="text-xs text-gray-500">{t(lang, 'common.realEstateOffice')}</p>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1">
        <a href={localizePath('/', lang)} class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
          {t(lang, 'nav.home')}
        </a>

        <!-- Αγορά Dropdown -->
        <div class="relative group">
          <a href={localizePath('/agora', lang)} class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors inline-flex items-center gap-1">
            {t(lang, 'nav.agora')}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-white rounded-xl shadow-xl border border-gray-100 py-2 min-w-[220px]">
              <a href={localizePath('/agora', lang)} class="block px-4 py-2.5 text-sm text-gray-700 hover:text-primary hover:bg-gray-50 font-medium">
                {t(lang, 'nav.allListings')}
              </a>
              <div class="border-t border-gray-100 my-1"></div>
              {agoraCategories.filter(c => !c.parent_id).map(cat => (
                <a href={localizePath(`/agora/${cat.slug}`, lang)} class="block px-4 py-2.5 text-sm text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors">
                  {catName(cat)}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Ενοικίαση Dropdown -->
        <div class="relative group">
          <a href={localizePath('/enoikiasi', lang)} class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors inline-flex items-center gap-1">
            {t(lang, 'nav.enoikiasi')}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-white rounded-xl shadow-xl border border-gray-100 py-2 min-w-[220px]">
              <a href={localizePath('/enoikiasi', lang)} class="block px-4 py-2.5 text-sm text-gray-700 hover:text-primary hover:bg-gray-50 font-medium">
                {t(lang, 'nav.allListings')}
              </a>
              <div class="border-t border-gray-100 my-1"></div>
              {enoikiasiCategories.filter(c => !c.parent_id).map(cat => (
                <a href={localizePath(`/enoikiasi/${cat.slug}`, lang)} class="block px-4 py-2.5 text-sm text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors">
                  {catName(cat)}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href={localizePath('/grafeio', lang)} class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors">
          {t(lang, 'nav.grafeio')}
        </a>
      </nav>

      <!-- Right actions: language + phone -->
      <div class="flex items-center gap-2">
        <!-- Language switcher -->
        <div class="flex items-center rounded-xl border border-gray-200 p-0.5 text-xs font-semibold" aria-label={t(lang, 'nav.language')}>
          <a href={elHref} class={`px-2.5 py-1.5 rounded-lg transition-colors ${lang === 'el' ? 'bg-primary text-white' : 'text-gray-500 hover:text-primary'}`}>EL</a>
          <a href={enHref} class={`px-2.5 py-1.5 rounded-lg transition-colors ${lang === 'en' ? 'bg-primary text-white' : 'text-gray-500 hover:text-primary'}`}>EN</a>
        </div>

        <!-- Phone button + dropdown -->
        <div class="relative">
          <button
            id="phone-menu-btn"
            type="button"
            class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary text-white hover:bg-primary-light transition-colors shadow-sm"
            aria-label="Τηλέφωνα"
          >
            <PhoneIcon type="landline" class="w-5 h-5" />
          </button>
          <div id="phone-menu" class="hidden absolute right-0 top-full mt-2 min-w-[200px] bg-white rounded-xl shadow-xl border border-gray-100 py-2 z-50">
            {phones.map(ph => (
              <a href={`tel:${ph.number}`} class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors">
                <PhoneIcon type={ph.type} class="w-4 h-4 text-primary" />
                <span>{ph.number}</span>
              </a>
            ))}
            {phones.length === 0 && (
              <div class="px-4 py-2.5 text-sm text-gray-400">{t(lang, 'office.phone')}: —</div>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile navigation bar -->
    <nav class="lg:hidden border-t border-gray-100 -mx-4 px-4">
      <div class="flex items-center gap-1 overflow-x-auto py-2 whitespace-nowrap">
        {navItems.map(item => (
          <a href={item.href} class="px-3.5 py-2 rounded-lg text-sm font-medium text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors flex-shrink-0">
            {item.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  // Phone dropdown
  const phoneBtn = document.getElementById('phone-menu-btn');
  const phoneMenu = document.getElementById('phone-menu');
  phoneBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    phoneMenu?.classList.toggle('hidden');
  });
  document.addEventListener('click', (e) => {
    if (!phoneMenu || phoneMenu.classList.contains('hidden')) return;
    if (!phoneMenu.contains(e.target) && e.target !== phoneBtn) phoneMenu.classList.add('hidden');
  });

  // Live office settings
  const esc = (s) => String(s)
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');

  const mobileIcon = '<svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 2h8a2 2 0 012 2v16a2 2 0 01-2 2H8a2 2 0 01-2-2V4a2 2 0 012-2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 18h2"/></svg>';
  const landIcon = '<svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>';

  const renderPhones = (list) => {
    if (!phoneMenu) return;
    if (!list.length) {
      phoneMenu.innerHTML = '<div class="px-4 py-2.5 text-sm text-gray-400">—</div>';
      return;
    }
    phoneMenu.innerHTML = list.map(p => {
      const icon = p.type === 'mobile' ? mobileIcon : landIcon;
      return `<a href="tel:${esc(p.number)}" class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 hover:text-primary hover:bg-gray-50 transition-colors">${icon}<span>${esc(p.number)}</span></a>`;
    }).join('');
  };

  (async () => {
    try {
      const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
      const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
      if (!SUPABASE_URL || !SUPABASE_ANON_KEY || SUPABASE_URL.includes('placeholder')) return;

      const res = await fetch(`${SUPABASE_URL}/rest/v1/office_settings?select=*&limit=1`, {
        headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` }
      });
      if (!res.ok) return;
      const rows = await res.json();
      if (!rows || rows.length === 0) return;
      const s = rows[0];

      if (s.logo_url) {
        const logo = document.getElementById('header-logo');
        const fb = document.getElementById('header-logo-fallback');
        if (logo) {
          logo.src = s.logo_url;
          if (s.logo_height) logo.style.height = `${s.logo_height}px`;
          logo.classList.remove('hidden');
        }
        if (fb) fb.classList.add('hidden');
      }
      if (s.name) {
        const nameEl = document.getElementById('header-office-name');
        const isEn = document.documentElement.lang === 'en';
        if (nameEl) nameEl.textContent = isEn ? (s.name_en || s.name) : s.name;
      }

      // Build the phones list from live data
      let list = [];
      if (Array.isArray(s.phones) && s.phones.length) {
        list = s.phones.map(p => typeof p === 'string'
          ? { number: p.trim(), type: 'landline' }
          : { number: (p?.number || '').trim(), type: p?.type === 'mobile' ? 'mobile' : 'landline' }
        ).filter(p => p.number);
      } else if (s.phone) {
        list = [{ number: s.phone, type: 'landline' }];
      }
      renderPhones(list);
    } catch (e) {
      // silent fail — SSR values remain
    }
  })();
</script>
