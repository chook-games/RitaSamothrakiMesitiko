---
import Layout from '../../layouts/Layout.astro'
import { getWorkCategories, getWorks } from '../../lib/supabase'
import type { WorkCategory } from '../../lib/supabase'
import { t, localizePath, pick, type Lang } from '../../i18n/utils'

export interface Props {
  category?: WorkCategory | null
  lang?: Lang
}

const { category = null } = Astro.props
const lang: Lang = Astro.props.lang ?? ((Astro.currentLocale as Lang) ?? 'el')

const categories = await getWorkCategories()
const works = await getWorks({ categoryId: category?.id })

const catName = (c: WorkCategory) => pick(lang, c.name_el, c.name_en)
const workTitle = (w: { title_el: string | null; title_en: string | null }) => pick(lang, w.title_el, w.title_en)
const workDesc = (w: { description_el: string | null; description_en: string | null }) => pick(lang, w.description_el, w.description_en)

const pageTitle = category ? `${catName(category)} - ${t(lang, 'works.title')}` : t(lang, 'works.title')

// Overview groups works by category
const groups = categories.map(c => ({ category: c, items: works.filter(w => w.category_id === c.id) }))
const uncategorized = works.filter(w => !w.category_id)
---

<Layout title={`${pageTitle} | Rita Samothraki`} description={t(lang, 'works.subtitle')}>
  <div class="bg-gray-50 min-h-screen">
    <!-- Header -->
    <div class="relative bg-gradient-to-br from-primary-dark via-primary to-primary-light text-white overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
        <span class="text-sm font-semibold text-accent uppercase tracking-wider">{t(lang, 'works.kicker')}</span>
        <h1 class="text-3xl md:text-5xl font-bold mt-2 mb-3">{category ? catName(category) : t(lang, 'works.title')}</h1>
        <p class="text-white/80 max-w-2xl">{t(lang, 'works.subtitle')}</p>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <!-- Category filter -->
      {categories.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          <a href={localizePath('/ergasies', lang)} class={`px-4 py-2 text-sm font-medium rounded-xl transition-colors ${!category ? 'bg-primary text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-primary/10 hover:text-primary'}`}>
            {t(lang, 'common.all')}
          </a>
          {categories.map(c => (
            <a href={localizePath(`/ergasies/${c.slug}`, lang)} class={`px-4 py-2 text-sm font-medium rounded-xl transition-colors ${category && c.id === category.id ? 'bg-primary text-white' : 'bg-white text-gray-700 border border-gray-200 hover:bg-primary/10 hover:text-primary'}`}>
              {catName(c)}
            </a>
          ))}
        </div>
      )}

      {works.length === 0 && (
        <div class="text-center py-20">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">{t(lang, 'works.empty')}</h3>
        </div>
      )}

      <!-- Overview: grouped by category -->
      {!category && groups.map(group => (
        group.items.length > 0 && (
          <section class="mb-12">
            <h2 class="text-xl font-bold text-gray-900 mb-5 flex items-center gap-2">
              <span class="w-1 h-6 bg-accent rounded-full"></span>
              {catName(group.category)}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {group.items.map(work => (
                <article class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-lg transition-shadow">
                  <div class="aspect-[4/3] bg-gray-100 overflow-hidden">
                    {work.image_url ? (
                      <img src={work.image_url} alt={workTitle(work)} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-gray-300">
                        <svg class="w-14 h-14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      </div>
                    )}
                  </div>
                  <div class="p-5">
                    <h3 class="text-lg font-bold text-gray-900 mb-2">{workTitle(work)}</h3>
                    {workDesc(work) && <p class="text-sm text-gray-600 leading-relaxed whitespace-pre-line">{workDesc(work)}</p>}
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      ))}

      <!-- Category page: works grid -->
      {category && works.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {works.map(work => (
            <article class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-lg transition-shadow">
              <div class="aspect-[4/3] bg-gray-100 overflow-hidden">
                {work.image_url ? (
                  <img src={work.image_url} alt={workTitle(work)} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-300">
                    <svg class="w-14 h-14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </div>
                )}
              </div>
              <div class="p-5">
                <h3 class="text-lg font-bold text-gray-900 mb-2">{workTitle(work)}</h3>
                {workDesc(work) && <p class="text-sm text-gray-600 leading-relaxed whitespace-pre-line">{workDesc(work)}</p>}
              </div>
            </article>
          ))}
        </div>
      )}

      {uncategorized.length > 0 && (
        <section class="mt-12">
          <h2 class="text-xl font-bold text-gray-900 mb-5 flex items-center gap-2">
            <span class="w-1 h-6 bg-accent rounded-full"></span>
            {t(lang, 'works.title')}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {uncategorized.map(work => (
              <article class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
                <div class="aspect-[4/3] bg-gray-100 overflow-hidden">
                  {work.image_url ? <img src={work.image_url} alt={workTitle(work)} class="w-full h-full object-cover" loading="lazy" /> : null}
                </div>
                <div class="p-5">
                  <h3 class="text-lg font-bold text-gray-900 mb-2">{workTitle(work)}</h3>
                  {workDesc(work) && <p class="text-sm text-gray-600 leading-relaxed whitespace-pre-line">{workDesc(work)}</p>}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>
