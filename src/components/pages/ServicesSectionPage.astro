---
import Layout from '../../layouts/Layout.astro'
import { getServices } from '../../lib/supabase'
import type { ServiceSection } from '../../lib/supabase'
import { t, localizePath, pick, type Lang } from '../../i18n/utils'

export interface Props {
  section: ServiceSection
  lang?: Lang
}

const { section } = Astro.props
const lang: Lang = Astro.props.lang ?? ((Astro.currentLocale as Lang) ?? 'el')

const services = await getServices({ sectionId: section.id, withImages: true })
const sectionName = pick(lang, section.name_el, section.name_en)
const svcTitle = (s: { title_el: string | null; title_en: string | null }) => pick(lang, s.title_el, s.title_en)
const svcDesc = (s: { description_el: string | null; description_en: string | null }) => pick(lang, s.description_el, s.description_en)
const firstImage = (s: { images?: { url: string; order: number | null }[] }) => {
  if (!s.images || s.images.length === 0) return null
  return [...s.images].sort((a, b) => (a.order || 0) - (b.order || 0))[0].url
}
---

<Layout title={`${sectionName} | Rita Samothraki`} description={sectionName}>
  <div class="bg-gray-50 min-h-screen">
    <!-- Header -->
    <div class="relative bg-gradient-to-br from-primary-dark via-primary to-primary-light text-white overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
        <a href={localizePath('/', lang)} class="text-white/70 text-sm hover:text-white">{t(lang, 'nav.home')}</a>
        <h1 class="text-3xl md:text-5xl font-bold mt-3">{sectionName}</h1>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
      {services.length === 0 ? (
        <div class="text-center py-20">
          <h3 class="text-lg font-semibold text-gray-900">{t(lang, 'services.empty')}</h3>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {services.map(svc => (
            <a href={localizePath(`/services/${section.slug}/${svc.slug}`, lang)} class="group bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-300">
              <div class="aspect-[4/3] bg-gray-100 overflow-hidden">
                {firstImage(svc) ? (
                  <img src={firstImage(svc)!} alt={svcTitle(svc)} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-300">
                    <svg class="w-14 h-14" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  </div>
                )}
              </div>
              <div class="p-5">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-primary transition-colors mb-2">{svcTitle(svc)}</h3>
                {svcDesc(svc) && <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">{svcDesc(svc)}</p>}
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary group-hover:gap-2 transition-all">
                  {t(lang, 'common.view')}
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>
