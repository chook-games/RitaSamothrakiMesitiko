---
import Layout from '../../layouts/Layout.astro'
import { getService } from '../../lib/supabase'
import type { ServiceSection } from '../../lib/supabase'
import { t, localizePath, pick, type Lang } from '../../i18n/utils'

export interface Props {
  section: ServiceSection
  slug: string
  lang?: Lang
}

const { section, slug } = Astro.props
const lang: Lang = Astro.props.lang ?? ((Astro.currentLocale as Lang) ?? 'el')

const service = await getService(section.id, slug)
if (!service) {
  return Astro.redirect(localizePath('/404', lang))
}

const sectionName = pick(lang, section.name_el, section.name_en)
const title = pick(lang, service.title_el, service.title_en)
const description = pick(lang, service.description_el, service.description_en)
const images = (service.images || []).slice().sort((a, b) => (a.order || 0) - (b.order || 0))
---

<Layout title={`${title} | Rita Samothraki`} description={description?.slice(0, 160) || title}>
  <div class="bg-gray-50 min-h-screen">
    <!-- Header -->
    <div class="relative bg-gradient-to-br from-primary-dark via-primary to-primary-light text-white overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div>
            <div class="flex items-center gap-2 text-sm text-white/70 mb-3">
              <a href={localizePath('/', lang)} class="hover:text-white">{t(lang, 'nav.home')}</a>
              <span>/</span>
              <a href={localizePath(`/services/${section.slug}`, lang)} class="hover:text-white">{sectionName}</a>
            </div>
            <h1 class="text-3xl md:text-5xl font-bold">{title}</h1>
          </div>

          <!-- Contact card -->
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-5 md:min-w-[300px] shadow-lg">
            <h2 class="text-lg font-bold mb-1">{t(lang, 'services.contact')}</h2>
            <p class="text-white/80 text-sm mb-4">{t(lang, 'services.contactDesc')}</p>
            <a href={localizePath('/grafeio', lang)} class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 bg-accent text-primary-dark font-semibold rounded-xl hover:bg-accent-light transition-colors">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {t(lang, 'nav.grafeio')}
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14 space-y-10 md:space-y-14">
      {description && (
        <div class="bg-white rounded-2xl p-6 md:p-9 shadow-sm border border-gray-100">
          <p class="text-gray-700 leading-relaxed whitespace-pre-line text-[15px] md:text-base">{description}</p>
        </div>
      )}

      {images.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
          {images.map(img => {
            const caption = pick(lang, img.caption_el, img.caption_en)
            return (
              <figure class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
                <img src={img.url} alt={caption || title} class="w-full aspect-[4/3] object-cover" loading="lazy" />
                {caption && (
                  <figcaption class="p-4 text-sm text-gray-600 leading-relaxed whitespace-pre-line">{caption}</figcaption>
                )}
              </figure>
            )
          })}
        </div>
      )}

      {/* Contact CTA removed — moved into the hero */}
    </div>
  </div>
</Layout>
