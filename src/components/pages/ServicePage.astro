---
import Layout from '../../layouts/Layout.astro'
import { getService } from '../../lib/supabase'
import type { ServiceSection } from '../../lib/supabase'
import { t, localizePath, pick, type Lang } from '../../i18n/utils'

export interface Props {
  section: ServiceSection
  slug: string
  lang?: Lang
}

const { section, slug } = Astro.props
const lang: Lang = Astro.props.lang ?? ((Astro.currentLocale as Lang) ?? 'el')

const service = await getService(section.id, slug)
if (!service) {
  return Astro.redirect(localizePath('/404', lang))
}

const sectionName = pick(lang, section.name_el, section.name_en)
const title = pick(lang, service.title_el, service.title_en)
const description = pick(lang, service.description_el, service.description_en)
const images = (service.images || []).slice().sort((a, b) => (a.order || 0) - (b.order || 0))
---

<Layout title={`${title} | Rita Samothraki`} description={description?.slice(0, 160) || title}>
  <div class="bg-gray-50 min-h-screen">
    <!-- Header -->
    <div class="relative bg-gradient-to-br from-primary-dark via-primary to-primary-light text-white overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
        <div class="flex items-center gap-2 text-sm text-white/70 mb-3">
          <a href={localizePath('/', lang)} class="hover:text-white">{t(lang, 'nav.home')}</a>
          <span>/</span>
          <a href={localizePath(`/services/${section.slug}`, lang)} class="hover:text-white">{sectionName}</a>
        </div>
        <h1 class="text-3xl md:text-5xl font-bold">{title}</h1>
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14 space-y-10 md:space-y-14">
      {description && (
        <div class="bg-white rounded-2xl p-6 md:p-9 shadow-sm border border-gray-100">
          <p class="text-gray-700 leading-relaxed whitespace-pre-line text-[15px] md:text-base">{description}</p>
        </div>
      )}

      {images.map((img, i) => {
        const caption = pick(lang, img.caption_el, img.caption_en)
        return caption ? (
          <div class="grid md:grid-cols-2 gap-6 md:gap-10 items-center">
            <div class={`rounded-2xl overflow-hidden shadow-md border border-gray-100 ${i % 2 === 1 ? 'md:order-2' : ''}`}>
              <img src={img.url} alt={caption} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class={i % 2 === 1 ? 'md:order-1' : ''}>
              <p class="text-gray-600 leading-relaxed whitespace-pre-line">{caption}</p>
            </div>
          </div>
        ) : (
          <div class="rounded-2xl overflow-hidden shadow-md border border-gray-100">
            <img src={img.url} alt={title} class="w-full h-auto object-cover" loading="lazy" />
          </div>
        )
      })}

      <!-- Contact CTA -->
      <div class="bg-gradient-to-r from-primary-dark via-primary to-primary-light rounded-2xl p-6 md:p-8 text-white flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold">{t(lang, 'services.contact')}</h2>
          <p class="text-white/80 text-sm">{t(lang, 'services.contactDesc')}</p>
        </div>
        <a href={localizePath('/grafeio', lang)} class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-primary-dark font-semibold rounded-xl hover:bg-accent-light transition-colors whitespace-nowrap">
          {t(lang, 'services.contact')}
        </a>
      </div>
    </div>
  </div>
</Layout>
