---
import Layout from '../../layouts/Layout.astro'
import { getOfficeSettings } from '../../lib/supabase'
import { t, localizePath, pick, type Lang } from '../../i18n/utils'

export interface Props {
  lang?: Lang
}

const lang: Lang = Astro.props.lang ?? ((Astro.currentLocale as Lang) ?? 'el')
const settings = await getOfficeSettings()
const officeName = pick(lang, settings?.name || 'Rita Samothraki', settings?.name_en || settings?.name)
const aboutText = pick(lang, settings?.about_text, settings?.about_text_en)
---

<Layout title={`${t(lang, 'meta.grafeioTitle')} | Rita Samothraki`} description={aboutText || t(lang, 'meta.homeDescription')}>
  <div class="bg-gray-50 min-h-screen">
    <!-- Hero -->
    <div class="relative bg-gradient-to-br from-primary-dark via-primary to-primary-light text-white overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
        <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
          <!-- Logo -->
          <div class="flex-shrink-0">
            {settings?.logo_url ? (
              <img src={settings.logo_url} alt={officeName} class="w-32 h-32 md:w-40 md:h-40 rounded-2xl object-cover shadow-2xl border-4 border-white/20" />
            ) : (
              <div class="w-32 h-32 md:w-40 md:h-40 rounded-2xl bg-white/10 flex items-center justify-center border-4 border-white/20">
                <span class="text-5xl font-bold text-white">RS</span>
              </div>
            )}
          </div>

          <div class="text-center md:text-left">
            <h1 class="text-3xl md:text-5xl font-bold mb-3">
              {officeName}
            </h1>
            <p class="text-xl text-white/80 mb-2">{t(lang, 'common.realEstateOffice')}</p>
            <div class="flex flex-wrap justify-center md:justify-start gap-4 mt-6">
              {settings?.phone && (
                <a href={`tel:${settings.phone}`} class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent text-primary-dark font-semibold rounded-xl hover:bg-accent-light transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  {settings.phone}
                </a>
              )}
              {settings?.email && (
                <a href={`mailto:${settings.email}`} class="inline-flex items-center gap-2 px-5 py-2.5 bg-white/10 backdrop-blur-sm text-white font-medium rounded-xl hover:bg-white/20 transition-colors border border-white/20">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  {settings.email}
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- About Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">{t(lang, 'office.aboutTitle')}</h2>
            {aboutText ? (
              <div class="prose prose-gray max-w-none">
                <p class="text-gray-600 leading-relaxed whitespace-pre-line">{aboutText}</p>
              </div>
            ) : (
              <div>
                <p class="text-gray-600 leading-relaxed mb-4">{t(lang, 'office.aboutFallback1')}</p>
                <p class="text-gray-600 leading-relaxed">{t(lang, 'office.aboutFallback2')}</p>
              </div>
            )}
          </div>

          <!-- Map -->
          {settings?.address && (
            <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-gray-100 mt-6">
              <h2 class="text-xl font-bold text-gray-900 mb-4">{t(lang, 'office.location')}</h2>
              <div class="aspect-video rounded-xl overflow-hidden bg-gray-100">
                <iframe
                  src={`https://www.google.com/maps?q=${encodeURIComponent(settings.address)}&output=embed`}
                  class="w-full h-full"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>
              <p class="text-sm text-gray-500 mt-3 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                {settings.address}
              </p>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Contact Card -->
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <h3 class="text-lg font-bold text-gray-900 mb-4">{t(lang, 'office.contactInfo')}</h3>
            <div class="space-y-4">
              {settings?.phone && (
                <div>
                  <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">{t(lang, 'office.phone')}</p>
                  <a href={`tel:${settings.phone}`} class="text-primary font-semibold hover:text-primary-light transition-colors">{settings.phone}</a>
                </div>
              )}
              {settings?.email && (
                <div>
                  <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">{t(lang, 'office.email')}</p>
                  <a href={`mailto:${settings.email}`} class="text-primary font-semibold hover:text-primary-light transition-colors break-all">{settings.email}</a>
                </div>
              )}
              {settings?.address && (
                <div>
                  <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">{t(lang, 'office.address')}</p>
                  <p class="text-gray-700">{settings.address}</p>
                </div>
              )}
            </div>

            <!-- Social -->
            {settings?.social_links && (
              <div class="border-t border-gray-100 pt-4 mt-4">
                <p class="text-xs text-gray-400 uppercase tracking-wider mb-3">Social Media</p>
                <div class="flex gap-2">
                  {settings.social_links.facebook && (
                    <a href={settings.social_links.facebook} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-100 hover:bg-primary/10 rounded-xl flex items-center justify-center transition-colors" aria-label="Facebook">
                      <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                  )}
                  {settings.social_links.instagram && (
                    <a href={settings.social_links.instagram} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-100 hover:bg-primary/10 rounded-xl flex items-center justify-center transition-colors" aria-label="Instagram">
                      <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </a>
                  )}
                  {settings.social_links.youtube && (
                    <a href={settings.social_links.youtube} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-100 hover:bg-primary/10 rounded-xl flex items-center justify-center transition-colors" aria-label="YouTube">
                      <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                    </a>
                  )}
                </div>
              </div>
            )}
          </div>

          <!-- Quick Actions -->
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <h3 class="text-lg font-bold text-gray-900 mb-4">{t(lang, 'office.quickActions')}</h3>
            <div class="space-y-3">
              <a href={localizePath('/agora', lang)} class="flex items-center justify-between px-4 py-3 bg-gray-50 rounded-xl hover:bg-primary/5 transition-colors">
                <span class="text-sm font-medium text-gray-700">{t(lang, 'office.buyProperties')}</span>
                <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
              <a href={localizePath('/enoikiasi', lang)} class="flex items-center justify-between px-4 py-3 bg-gray-50 rounded-xl hover:bg-primary/5 transition-colors">
                <span class="text-sm font-medium text-gray-700">{t(lang, 'office.rentProperties')}</span>
                <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
