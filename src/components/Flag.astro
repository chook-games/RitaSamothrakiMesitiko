---
export interface Props {
  lang: string
  class?: string
}

const { lang, class: cls = 'w-5 h-[14px] rounded-[2px] object-cover shadow-sm' } = Astro.props

const map: Record<string, string> = { el: 'gr', en: 'gb', de: 'de' }
const code = map[lang] || lang
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '')
---

<img src={`${base}/flags/${code}.svg`} alt="" class={cls} loading="lazy" />
