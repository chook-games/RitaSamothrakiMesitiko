---
import type { Listing } from '../lib/supabase'
import { t, localizePath, pick, type Lang } from '../i18n/utils'

export interface Props {
  listing: Listing
  lang?: Lang
}

const { listing } = Astro.props
const lang: Lang = Astro.props.lang ?? 'el'

const mainImage = listing.images && listing.images.length > 0
  ? listing.images.sort((a, b) => a.order - b.order)[0].url
  : null
const formattedPrice = new Intl.NumberFormat(lang === 'en' ? 'en-GB' : 'el-GR', {
  style: 'currency',
  currency: 'EUR',
  maximumFractionDigits: 0,
}).format(listing.price)

const title = pick(lang, listing.title, listing.title_en)
const categoryName = listing.category ? pick(lang, listing.category.name_el, listing.category.name_en) : ''
---

<a href={localizePath(`/aggelia/${listing.id}`, lang)} class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100">
  <!-- Image -->
  <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
    {mainImage ? (
      <img
        src={mainImage}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <svg class="w-16 h-16 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}

    <!-- Badges -->
    <div class="absolute top-3 left-3 flex flex-col gap-2">
      {listing.is_featured && (
        <span class="px-3 py-1 bg-accent text-primary-dark text-xs font-semibold rounded-full shadow-sm">
          {t(lang, 'card.featured')}
        </span>
      )}
    </div>

    <!-- Price on image -->
    <div class="absolute bottom-3 right-3">
      <span class="px-3 py-1.5 bg-white/95 backdrop-blur-sm text-primary-dark text-sm font-bold rounded-xl shadow-sm">
        {formattedPrice}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-4">
    <div class="flex items-center gap-2 mb-2">
      {listing.code && (
        <span class="text-xs text-gray-400 font-mono">#{listing.code}</span>
      )}
      {categoryName && (
        <span class="text-xs text-primary-light bg-primary/5 px-2 py-0.5 rounded-full">
          {categoryName}
        </span>
      )}
    </div>
    <h3 class="text-sm font-semibold text-gray-900 line-clamp-2 group-hover:text-primary transition-colors leading-snug mb-3">
      {title}
    </h3>

    <div class="flex items-center justify-between">
      <span class="text-base font-bold text-primary">
        {formattedPrice}
      </span>
      {listing.images && listing.images.length > 1 && (
        <span class="text-xs text-gray-400 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          {listing.images.length}
        </span>
      )}
    </div>
  </div>
</a>
