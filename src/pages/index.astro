---
import Layout from '../layouts/Layout.astro'
import ListingCard from '../components/ListingCard.astro'
import CategoryCard from '../components/CategoryCard.astro'
import { getListings, getCategories, getOfficeSettings } from '../lib/supabase'

const featuredListings = await getListings({ featured: true, limit: 8 })
const recentListings = await getListings({ limit: 6, status: 'active' })
const categories = await getCategories()
const settings = await getOfficeSettings()

const agoraCategories = categories.filter(c => c.type === 'agora' && !c.parent_id)
const enoikiasiCategories = categories.filter(c => c.type === 'enoikiasi' && !c.parent_id)
---

<Layout title="Rita Samothraki - Μεσιτικό Γραφείο | Αγοραπωλησίες & Ενοικιάσεις Ακινήτων">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-dark via-primary to-primary-light text-white overflow-hidden">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHZpZXdCb3g9IjAgMCA2MCA2MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxnIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4wMyI+PGNpcmNsZSBjeD0iMzAiIGN5PSIzMCIgcj0iMiIvPjwvZz48L2c+PC9zdmc+')] opacity-50"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm text-white/90 mb-6">
          <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
          {settings?.name || 'Rita Samothraki'} — Μεσιτικό Γραφείο
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
          Βρείτε το <span class="text-accent">ιδανικό σας</span> ακίνητο
        </h1>
        <p class="text-lg md:text-xl text-white/80 leading-relaxed mb-8 max-w-2xl">
          Επαγγελματικές υπηρεσίες μεσιτείας με αξιοπιστία, διαφάνεια και εξατομικευμένη εξυπηρέτηση. Ανακαλύψτε τις αγγελίες μας.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/agora" class="inline-flex items-center gap-2 px-6 py-3.5 bg-accent text-primary-dark font-semibold rounded-xl hover:bg-accent-light transition-colors shadow-lg shadow-accent/25">
            Αγορά Ακινήτου
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="/enoikiasi" class="inline-flex items-center gap-2 px-6 py-3.5 bg-white/10 backdrop-blur-sm text-white font-semibold rounded-xl hover:bg-white/20 transition-colors border border-white/20">
            Ενοικίαση
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          </a>
        </div>
      </div>
    </div>
    <!-- Decorative bottom wave -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 60V30C240 0 480 0 720 30C960 60 1200 60 1440 30V60H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Featured Listings (Highlights) -->
  {featuredListings.length > 0 && (
    <section class="py-16 md:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-sm font-semibold text-accent uppercase tracking-wider">Προτεινόμενα</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2">Κορυφαίες Προτεινόμενες Αγγελίες</h2>
          <p class="text-gray-500 mt-3 max-w-xl mx-auto">Επιλεγμένες αγγελίες που ξεχωρίζουν — ανακαλύψτε τις καλύτερες ευκαιρίες</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredListings.map(listing => (
            <ListingCard listing={listing} />
          ))}
        </div>
        <div class="text-center mt-10">
          <a href="/agora" class="inline-flex items-center gap-2 px-6 py-3 text-primary font-semibold hover:gap-3 transition-all">
            Δείτε όλες τις αγγελίες
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Categories Section -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-sm font-semibold text-accent uppercase tracking-wider">Κατηγορίες</span>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2">Βρείτε αυτό που ψάχνετε</h2>
        <p class="text-gray-500 mt-3 max-w-xl mx-auto">Εξερευνήστε τις αγγελίες μας ανά κατηγορία</p>
      </div>

      <!-- Αγορά Categories -->
      <div class="mb-12">
        <h3 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
          <span class="w-1 h-6 bg-accent rounded-full"></span>
          Αγορά
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {agoraCategories.map(cat => (
            <CategoryCard
              title={cat.name_el}
              description={`Δείτε όλες τις αγγελίες για ${cat.name_el.toLowerCase()}`}
              href={`/agora/${cat.slug}`}
              icon={cat.slug === 'monokatikia' ? 'home' : cat.slug === 'diamerisma' ? 'apartment' : cat.slug === 'ktirio' ? 'building' : cat.slug === 'oikopedo' ? 'land' : 'commercial'}
            />
          ))}
          <CategoryCard
            title="Όλες οι Αγγελίες"
            description="Περιηγηθείτε σε όλες τις αγγελίες αγοράς"
            href="/agora"
            icon="commercial"
          />
        </div>
      </div>

      <!-- Ενοικίαση Categories -->
      <div class="mb-8">
        <h3 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
          <span class="w-1 h-6 bg-accent rounded-full"></span>
          Ενοικίαση
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {enoikiasiCategories.map(cat => (
            <CategoryCard
              title={cat.name_el}
              description={`Δείτε όλες τις αγγελίες ενοικίασης για ${cat.name_el.toLowerCase()}`}
              href={`/enoikiasi/${cat.slug}`}
              icon={cat.slug === 'monokatikia' ? 'home' : 'apartment'}
            />
          ))}
          <CategoryCard
            title="Όλες οι Αγγελίες"
            description="Περιηγηθείτε σε όλες τις αγγελίες ενοικίασης"
            href="/enoikiasi"
            icon="commercial"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Listings -->
  {recentListings.length > 0 && (
    <section class="py-16 md:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-10">
          <div>
            <span class="text-sm font-semibold text-accent uppercase tracking-wider">Πρόσφατα</span>
            <h2 class="text-3xl font-bold text-gray-900 mt-2">Πρόσφατες Αγγελίες</h2>
          </div>
          <a href="/agora" class="hidden sm:inline-flex items-center gap-2 text-sm font-medium text-primary hover:gap-3 transition-all">
            Όλες οι αγγελίες
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentListings.map(listing => (
            <ListingCard listing={listing} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Sold Section CTA -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-primary-dark via-primary to-primary-light rounded-3xl p-8 md:p-12 text-white relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNDAiIGhlaWdodD0iNDAiIHZpZXdCb3g9IjAgMCA0MCA0MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxnIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4wNSI+PGNpcmNsZSBjeD0iMjAiIGN5PSIyMCIgcj0iMiIvPjwvZz48L2c+PC9zdmc+')]"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold mb-2">Αγγελίες που Πουλήθηκαν</h2>
            <p class="text-white/80">Δείτε τα ακίνητα που έχουμε ήδη πουλήσει — η εμπειρία μας μιλάει</p>
          </div>
          <a href="/poulithike" class="inline-flex items-center gap-2 px-6 py-3.5 bg-white text-primary font-semibold rounded-xl hover:bg-accent hover:text-primary-dark transition-all whitespace-nowrap shadow-lg">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Πουλήθηκε
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats / Trust Section -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-4xl font-extrabold text-primary mb-1">150+</div>
          <div class="text-sm text-gray-500">Επιτυχημένες Αγγελίες</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-extrabold text-primary mb-1">12+</div>
          <div class="text-sm text-gray-500">Χρόνια Εμπειρίας</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-extrabold text-primary mb-1">100%</div>
          <div class="text-sm text-gray-500">Ικανοποιημένοι Πελάτες</div>
        </div>
        <div class="text-center">
          <div class="text-4xl font-extrabold text-primary mb-1">50+</div>
          <div class="text-sm text-gray-500">Ενεργές Αγγελίες</div>
        </div>
      </div>
    </div>
  </section>
</Layout>
