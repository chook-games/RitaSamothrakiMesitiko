---
import WorksPage from '../../../components/pages/WorksPage.astro'
import { getWorkCategories } from '../../../lib/supabase'

export async function getStaticPaths() {
  const categories = await getWorkCategories()
  return categories.map(cat => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }))
}

const { category } = Astro.props
---

<WorksPage category={category} lang="de" />
