---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import type { Lang } from '../i18n/utils'

export interface Props {
  title?: string
  description?: string
  hideHeader?: boolean
  hideFooter?: boolean
  disableLangDetect?: boolean
}

const {
  title = 'Rita Samothraki - Μεσιτικό Γραφείο',
  description = 'Επαγγελματικές υπηρεσίες μεσιτείας με αξιοπιστία και εμπειρία',
  hideHeader = false,
  hideFooter = false,
  disableLangDetect = false
} = Astro.props

const lang = (Astro.currentLocale as Lang) ?? 'el'
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${(import.meta.env.BASE_URL || '/').replace(/\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased flex flex-col overflow-x-hidden">
    {!hideHeader && <Header lang={lang} />}
    <main class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer lang={lang} />}

    {!disableLangDetect && (
    <script>
      // Auto-detect visitor country once: Greece → Greek, German-speaking → German, otherwise English.
      // Skipped if the user has manually chosen a language before.
      (() => {
        try {
          if (localStorage.getItem('langChosen')) return;
          if (sessionStorage.getItem('langAuto')) return;

          const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
          let p = location.pathname;
          if (base && p.startsWith(base)) p = p.slice(base.length);
          if (!p.startsWith('/')) p = '/' + p;

          const locales = ['en', 'de'];
          const parts = p.split('/').filter(Boolean);
          const seg = parts[0];
          const current = locales.includes(seg) ? seg : 'el';
          const restParts = locales.includes(seg) ? parts.slice(1) : parts;
          const rest = restParts.length ? '/' + restParts.join('/') + (p.endsWith('/') ? '/' : '') : '/';

          const redirectTo = (target) => {
            if (target === current) return;
            const targetPath = target === 'el' ? rest : (rest === '/' ? `/${target}/` : `/${target}${rest}`);
            try { sessionStorage.setItem('langAuto', '1'); } catch (e) {}
            location.replace(base + targetPath);
          };

          const targetForCountry = (country) => {
            if (country === 'GR') return 'el';
            if (['DE', 'AT', 'CH'].includes(country)) return 'de';
            return 'en';
          };

          fetch('/cdn-cgi/trace', { cache: 'no-store' })
            .then(r => (r.ok ? r.text() : Promise.reject()))
            .then(t => {
              const m = t.match(/^loc=([A-Z]+)/m);
              redirectTo(targetForCountry(m ? m[1] : ''));
            })
            .catch(() => {
              const l = (navigator.language || '').toLowerCase();
              redirectTo(l.startsWith('el') ? 'el' : l.startsWith('de') ? 'de' : 'en');
            });
        } catch (e) {}
      })();
    </script>
    )}
  </body>
</html>
