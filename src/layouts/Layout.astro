---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import type { Lang } from '../i18n/utils'

export interface Props {
  title?: string
  description?: string
  hideHeader?: boolean
  hideFooter?: boolean
}

const {
  title = 'Rita Samothraki - Μεσιτικό Γραφείο',
  description = 'Επαγγελματικές υπηρεσίες μεσιτείας με αξιοπιστία και εμπειρία',
  hideHeader = false,
  hideFooter = false
} = Astro.props

const lang = (Astro.currentLocale as Lang) ?? 'el'
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${(import.meta.env.BASE_URL || '/').replace(/\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased flex flex-col overflow-x-hidden">
    {!hideHeader && <Header lang={lang} />}
    <main class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer lang={lang} />}
  </body>
</html>
